# Path on the host to your Claude Code data directory.
# This is bind-mounted read-only into the container.
CLAUDE_HOME=${USERPROFILE}/.claude

# Initial widget state for browsers that have no saved dashboard choice.
# All providers are still polled; the dashboard toggle is persisted per
# browser in localStorage and overrides this default after the first visit.
CLAUDE_ENABLED=true

# Path on the host to your Codex CLI data directory. Bind-mounted read-only.
CODEX_HOME=${USERPROFILE}/.codex
CODEX_ENABLED=true

# The dashboard calls each provider's own live usage endpoint using the token
# its local client stores. Claude and Codex report rolling-window percentages.
# If a live call fails, that panel renders an "unavailable" state.

# Optional: override the hosts the live endpoints are called against. Must be
# https://, and an overridden host must also be added to EGRESS_ALLOW below.
# CLAUDE_AI_HOST=https://claude.ai
# CHATGPT_HOST=https://chatgpt.com

# The dashboard's only route out is an allow-listing proxy (the `egress`
# service) that admits claude.ai and chatgpt.com. List extra hosts here,
# comma- or space-separated: `host` for port 443, `host:port` for another,
# `.example.com` for a domain and everything under it. Apply a change with
# `docker compose up -d egress`.
EGRESS_ALLOW=

# How long to cache each live response in-memory (seconds). Multiple SSE
# clients share one fetch — keep this >= REFRESH_INTERVAL_SECONDS.
QUOTA_CACHE_TTL_SECONDS=30

# How long to cache local activity scans (seconds).
CLAUDE_ACTIVITY_CACHE_TTL_SECONDS=5
CODEX_ACTIVITY_CACHE_TTL_SECONDS=5

# Refresh cadence pushed to the browser, in seconds.
REFRESH_INTERVAL_SECONDS=5

# Who the dashboard serves. It has no login, so these two lines are its access
# control, and they are set together.
#
# DASHBOARD_BIND is the host address the port is published on. The default
# serves this machine alone: with it, no LAN peer reaches the dashboard, and
# neither does another container on this Docker host by way of the bridge
# gateway. (A host firewall would not stop either of them -- Docker's
# forwarding runs ahead of ufw/firewalld rules.) Give it the address, not the
# port: an `address:port` value in DASHBOARD_PORT used to work and no longer
# does.
#
# DASHBOARD_ALLOWED_HOSTS is the list of names a browser may use to ask for it,
# checked on every route. Without it, a web page anyone visits can point a name
# of its own at 127.0.0.1 and read your dashboard as if it were its own page.
#
# To serve other machines, widen both: set DASHBOARD_BIND to the address of the
# interface they reach you on (or 0.0.0.0 for all of them), and add the host
# name or IP they type to DASHBOARD_ALLOWED_HOSTS. Names are matched exactly; a
# port is ignored, and a whole name is what matches: `*.dash.example` is not a
# pattern here and is dropped with a warning. `*` on its own accepts any name,
# and belongs only in front of something else that decides who may ask. Apply a change with `docker compose up -d`.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Port exposed on the host.
DASHBOARD_PORT=8765
