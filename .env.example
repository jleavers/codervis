# Path on the host to your Claude Code data directory.
# This is bind-mounted read-only into the container.
CLAUDE_HOME=${USERPROFILE}/.claude

# Path on the host to your Codex CLI data directory. Bind-mounted read-only.
# Set CODEX_ENABLED=false if you don't use Codex (the bind mount can then
# point at any existing directory or be left as the default).
CODEX_HOME=${USERPROFILE}/.codex
CODEX_ENABLED=true

# The dashboard calls claude.ai's /api/oauth/usage using the OAuth token
# Claude Code keeps in $CLAUDE_HOME/.credentials.json, and (separately)
# chatgpt.com's /backend-api/wham/usage using the token Codex CLI keeps
# in $CODEX_HOME/auth.json. Percentages come straight from each server,
# so no local token limits are needed. If a live call fails, that panel
# renders an "unavailable" state.

# Optional: override the hosts the live endpoints are called against.
# CLAUDE_AI_HOST=https://claude.ai
# CHATGPT_HOST=https://chatgpt.com

# How long to cache each live response in-memory (seconds). Multiple SSE
# clients share one fetch — keep this >= REFRESH_INTERVAL_SECONDS.
QUOTA_CACHE_TTL_SECONDS=30

# How long to cache local activity scans (seconds).
CLAUDE_ACTIVITY_CACHE_TTL_SECONDS=5
CODEX_ACTIVITY_CACHE_TTL_SECONDS=5

# Refresh cadence pushed to the browser, in seconds.
REFRESH_INTERVAL_SECONDS=5

# Port exposed on the host.
DASHBOARD_PORT=8765
