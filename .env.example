# Path on the host to your Claude Code data directory.
# This is bind-mounted read-only into the container.
CLAUDE_HOME=${USERPROFILE}/.claude

# The dashboard calls claude.ai's /api/oauth/usage using the OAuth token
# Claude Code keeps in $CLAUDE_HOME/.credentials.json. Percentages come
# straight from the server, so no token limits are needed.
#
# These are only consulted if the live endpoint is unreachable, in which
# case the dashboard falls back to estimating usage from local transcripts.
FIVE_HOUR_TOKEN_LIMIT=500000
WEEKLY_TOKEN_LIMIT=3000000

# Optional: override the host the live endpoint is called against.
# CLAUDE_AI_HOST=https://claude.ai

# How long to cache the live response in-memory (seconds). Multiple SSE
# clients share one fetch — keep this >= REFRESH_INTERVAL_SECONDS.
QUOTA_CACHE_TTL_SECONDS=30

# Refresh cadence pushed to the browser, in seconds.
REFRESH_INTERVAL_SECONDS=5

# Port exposed on the host.
DASHBOARD_PORT=8765
