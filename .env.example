# Path on the host to your Claude Code data directory.
# This is bind-mounted read-only into the container.
CLAUDE_HOME=${USERPROFILE}/.claude

# Path on the host to your Codex CLI data directory. Bind-mounted read-only.
# Set CODEX_ENABLED=false if you don't use Codex (the bind mount can then
# point at any existing directory or be left as the default).
CODEX_HOME=${USERPROFILE}/.codex
CODEX_ENABLED=true

# Path on the host to your Cursor application data directory (the one that
# contains User/globalStorage/state.vscdb). Bind-mounted read-only.
#   Windows: ${APPDATA}/Cursor       (e.g. C:/Users/you/AppData/Roaming/Cursor)
#   macOS:   ~/Library/Application Support/Cursor
#   Linux:   ~/.config/Cursor
# Set CURSOR_ENABLED=false if you don't use Cursor.
CURSOR_HOME=${APPDATA}/Cursor
CURSOR_ENABLED=true

# GitHub Copilot has two modes — pick ONE:
#
# (A) File mode (default): for clients that write the OAuth token to a file —
#     Neovim copilot.vim/lua, JetBrains, Eclipse, the Copilot language server.
#     Point COPILOT_HOME at the config dir containing apps.json / hosts.json.
#       Windows: ${USERPROFILE}/.config/github-copilot  (some use
#                ${LOCALAPPDATA}/github-copilot)
#       macOS/Linux: ~/.config/github-copilot
#     NOTE: VS Code does NOT write this file (its token is in the OS keychain),
#     so VS-Code-only users must use PAT mode below.
COPILOT_HOME=${USERPROFILE}/.config/github-copilot
COPILOT_ENABLED=true
#
# (B) PAT mode: set COPILOT_GITHUB_TOKEN to a fine-grained PAT with the "Plan"
#     read permission (github.com → Settings → Developer settings → Fine-grained
#     tokens). When set, codervis uses GitHub's documented billing REST API and
#     ignores COPILOT_HOME. The billing report gives consumption only, so the
#     allowance comes from COPILOT_PLAN (free=50, pro=300, pro+=1500,
#     business=300, enterprise=1000) or an explicit COPILOT_PREMIUM_ALLOWANCE.
#     The username is auto-detected from the token (override with
#     COPILOT_GITHUB_USER). The 2nd gauge shows usage-based $ spend; set
#     COPILOT_SPEND_BUDGET to render it as a percentage. PAT mode reports
#     nothing for org/enterprise-managed Copilot licences.
# COPILOT_GITHUB_TOKEN=github_pat_xxx
# COPILOT_GITHUB_USER=your-login
# COPILOT_PLAN=pro
# COPILOT_PREMIUM_ALLOWANCE=300
# COPILOT_SPEND_BUDGET=10

# The dashboard calls claude.ai's /api/oauth/usage using the OAuth token
# Claude Code keeps in $CLAUDE_HOME/.credentials.json, and (separately)
# chatgpt.com's /backend-api/wham/usage using the token Codex CLI keeps
# in $CODEX_HOME/auth.json. Percentages come straight from each server,
# so no local token limits are needed. Cursor is different: its session
# token lives in a SQLite DB ($CURSOR_HOME/User/globalStorage/state.vscdb)
# and the dashboard derives monthly premium-request and usage-based-spend
# percentages from cursor.com's dashboard endpoints. If a live call fails,
# that panel renders an "unavailable" state.

# Optional: override the hosts the live endpoints are called against.
# CLAUDE_AI_HOST=https://claude.ai
# CHATGPT_HOST=https://chatgpt.com
# CURSOR_HOST=https://cursor.com
# GITHUB_API_HOST=https://api.github.com

# How long to cache each live response in-memory (seconds). Multiple SSE
# clients share one fetch — keep this >= REFRESH_INTERVAL_SECONDS.
QUOTA_CACHE_TTL_SECONDS=30

# How long to cache local activity scans (seconds).
CLAUDE_ACTIVITY_CACHE_TTL_SECONDS=5
CODEX_ACTIVITY_CACHE_TTL_SECONDS=5
CURSOR_ACTIVITY_CACHE_TTL_SECONDS=5
COPILOT_ACTIVITY_CACHE_TTL_SECONDS=5

# Refresh cadence pushed to the browser, in seconds.
REFRESH_INTERVAL_SECONDS=5

# Port exposed on the host.
DASHBOARD_PORT=8765
