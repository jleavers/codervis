# Path on the host to your Claude Code data directory.
# This is bind-mounted read-only into the container.
CLAUDE_HOME=${USERPROFILE}/.claude

# Initial widget state for browsers that have no saved dashboard choice.
# All providers are still polled; the dashboard toggle is persisted per
# browser in localStorage and overrides this default after the first visit.
CLAUDE_ENABLED=true

# Path on the host to your Codex CLI data directory. Bind-mounted read-only.
CODEX_HOME=${USERPROFILE}/.codex
CODEX_ENABLED=true

# The dashboard calls each provider's own live usage endpoint using the token
# its local client stores. Claude and Codex report rolling-window percentages.
# If a live call fails, that panel renders an "unavailable" state.

# Optional: override the hosts the live endpoints are called against. Must be
# https://, and an overridden host must also be added to EGRESS_ALLOW below.
# CLAUDE_AI_HOST=https://claude.ai
# CHATGPT_HOST=https://chatgpt.com

# The dashboard's only route out is an allow-listing proxy (the `egress`
# service) that admits claude.ai and chatgpt.com. List extra hosts here,
# comma- or space-separated: `host` for port 443, `host:port` for another,
# `.example.com` for a domain and everything under it. Apply a change with
# `docker compose up -d egress`.
EGRESS_ALLOW=

# How often each source is read in the background, in seconds. This is the
# only thing that decides how often a credential is read or an upstream call
# is made: no number of browsers, tabs or SSE connections can add one. Keep
# the quota interval >= REFRESH_INTERVAL_SECONDS.
# (QUOTA_CACHE_TTL_SECONDS and *_ACTIVITY_CACHE_TTL_SECONDS are still read as
# the old names for these three, so an existing .env keeps working.)
QUOTA_REFRESH_INTERVAL_SECONDS=30
CLAUDE_ACTIVITY_REFRESH_INTERVAL_SECONDS=5
CODEX_ACTIVITY_REFRESH_INTERVAL_SECONDS=5

# How long to wait at startup for the first refresh of every source, so the
# first page load is served from real data rather than an unavailable state.
# Bounded and once only; the app starts either way.
STARTUP_REFRESH_WAIT_SECONDS=2

# Budgets for the reads that feed the payload. Everything they read is written
# by someone else — the vendor's response body, or whatever writes under
# ~/.claude — so each read has a deadline and a byte cap. Exceeding one
# degrades that source to "unavailable"; it never grows memory without bound.
# QUOTA_TIMEOUT_SECONDS is urllib's, per socket operation; the total deadline
# is what bounds a sender that trickles forever.
QUOTA_TIMEOUT_SECONDS=8
QUOTA_TOTAL_DEADLINE_SECONDS=10
QUOTA_MAX_RESPONSE_BYTES=1048576
ACTIVITY_SCAN_DEADLINE_SECONDS=5
ACTIVITY_MAX_LINE_BYTES=1048576
ACTIVITY_MAX_FILE_BYTES=16777216
ACTIVITY_MAX_FILES=20000

# Refresh cadence pushed to the browser, in seconds.
REFRESH_INTERVAL_SECONDS=5

# Port exposed on the host.
DASHBOARD_PORT=8765
