# Local debug captures — may contain OAuth tokens
*.log
usage-debug.log
latest

# Per-user Claude Code session state
.claude/settings.local.json

# Transient, per-run parts of .claude/ -- scoped deliberately, because
# .claude/skills/ and .claude/workflows/ are shared project configuration.
# security-sweeps/ holds local run artefacts (findings, reports) that stay
# local; see .claude/skills/security-sweep/SKILL.md.
.claude/worktrees/
.claude/security-sweeps/

# Local env
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.worktrees/
.superpowers/

# Editors
.idea/
.vscode/
